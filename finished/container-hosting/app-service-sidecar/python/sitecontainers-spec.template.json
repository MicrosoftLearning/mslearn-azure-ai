[
  {
    "name": "chat-api",
    "properties": {
      "image": "<registry-name>.azurecr.io/chat-api:v1",
      "targetPort": "8080",
      "isMain": true,
      "authType": "UserAssigned",
      "userManagedIdentityClientId": "<managed-identity-client-id>",
      "environmentVariables": [
        {
          "name": "MODEL_ENDPOINT",
          "value": "MODEL_ENDPOINT"
        }
      ],
      "volumeMounts": [
        {
          "volumeSubPath": "models/current",
          "containerMountPath": "/app/models",
          "readOnly": true
        }
      ]
    }
  },
  {
    "name": "model-server",
    "properties": {
      "image": "<registry-name>.azurecr.io/model-server:v1",
      "targetPort": "11434",
      "isMain": false,
      "authType": "UserAssigned",
      "userManagedIdentityClientId": "<managed-identity-client-id>",
      "environmentVariables": [
        {
          "name": "MODEL_NAME",
          "value": "MODEL_NAME"
        }
      ],
      "volumeMounts": [
        {
          "volumeSubPath": "models/current",
          "containerMountPath": "/models",
          "readOnly": false
        }
      ]
    }
  }
]
